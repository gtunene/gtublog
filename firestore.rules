rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             (request.auth.token.email.lower() == 'gerarditomusic@gmail.com' ||
              request.auth.token.email.lower() == 'info@dev.gtunene.com');
    }

    // 1. Waiting List: 100% Private (SuperAdmin only)
    match /waiting_list/{entryId} {
      allow read, write: if isSuperAdmin();
    }

    // 2. Ecosystem Users (100% Private: SuperAdmin only)
    match /ecosystem_users/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // 3. Ecosystem Global State (100% Private: SuperAdmin only)
    match /ecosystem_config/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // 3b. Ecosystem Trash Bin (100% Private: SuperAdmin only)
    match /ecosystem_trash/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // 4. Shared Users Collection (100% Private: SuperAdmin only)
    match /users/{userId} {
      allow read, write: if isSuperAdmin();
    }

    // 5. Vocal Score Studio Collections (100% Private: SuperAdmin only)
    match /conversions/{conversionId} {
      allow read, write: if isSuperAdmin();
    }
    match /human_orders/{orderId} {
      allow read, write: if isSuperAdmin();
    }
    match /settings/{settingId} {
      allow read, write: if isSuperAdmin();
    }

    // 6. AI Creative Assistant & SMM Collections (100% Private: SuperAdmin only)
    match /ai_creator_projects/{projectId} {
      allow read, write: if isSuperAdmin();
    }

    // 7. GTUBLOG Collections (100% Private: SuperAdmin only)
    match /blog_posts/{postId} {
      allow read, write: if isSuperAdmin();
    }
    match /blog_trash/{trashId} {
      allow read, write: if isSuperAdmin();
    }

    // 8. Gtuprod Playlists & Trash Bin (100% Private: SuperAdmin only)
    match /gtuprod_tracks/{trackId} {
      allow read, write: if isSuperAdmin();
    }
    match /gtuprod_trash/{trashId} {
      allow read, write: if isSuperAdmin();
    }

    // Catch-all: 100% Private (ONLY gerarditomusic@gmail.com and info@dev.gtunene.com)
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
